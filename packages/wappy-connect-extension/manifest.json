{
  "manifest_version": 3,
  "name": "WAPPY Connect - Google NotebookLM Sync",
  "version": "1.0.0",
  "description": "Vincula tu sesión de Google NotebookLM con WAPPY en un solo clic para tus agentes de Inteligencia Artificial.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WAPPY Connect",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "cookies",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.google.com/*",
    "*://notebooklm.google.com/*",
    "*://*.wappy.club/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
