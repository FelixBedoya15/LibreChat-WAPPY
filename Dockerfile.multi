# Dockerfile.multi
# WAPPY Optimized Fast Build

FROM node:20-alpine AS api-build

# Install jemalloc
RUN apk add --no-cache jemalloc
ENV LD_PRELOAD=/usr/lib/libjemalloc.so.2

WORKDIR /app
RUN apk --no-cache add curl

# Add `uv` for extended MCP support
COPY --from=ghcr.io/astral-sh/uv:0.6.13 /uv /uvx /bin/
RUN uv --version

# Instalar Chromium y dependencias para Puppeteer / WhatsApp Web JS
RUN apk add --no-cache \
    chromium \
    nss \
    freetype \
    harfbuzz \
    ca-certificates \
    ttf-freefont

RUN npm config set fetch-retry-maxtimeout 600000 && \
    npm config set fetch-retries 5 && \
    npm config set fetch-retry-mintimeout 15000

COPY package*.json ./
COPY packages/data-provider/package*.json ./packages/data-provider/
COPY packages/api/package*.json ./packages/api/
COPY packages/data-schemas/package*.json ./packages/data-schemas/
COPY packages/client/package*.json ./packages/client/
COPY client/package*.json ./client/
COPY api/package*.json ./api/
COPY patches/ ./patches/

# Install only production deps
RUN npm ci --omit=dev
RUN npx patch-package

COPY api ./api
COPY config ./config
COPY packages/data-provider/dist ./packages/data-provider/dist
COPY packages/data-schemas/dist ./packages/data-schemas/dist
COPY packages/api/dist ./packages/api/dist
COPY packages/client/dist ./packages/client/dist
COPY client/dist ./client/dist
COPY client/public ./client/public
COPY librechat.yaml ./librechat.yaml
COPY convocatoria_embajadores.html ./convocatoria_embajadores.html
COPY contratoembajadores.html ./contratoembajadores.html
COPY cursoappweb.html ./cursoappweb.html
COPY camaracomercioguajira.html ./camaracomercioguajira.html
COPY presentacion_arl_sura.html ./presentacion_arl_sura.html
COPY presentacion_arl_colmena.html ./presentacion_arl_colmena.html
# Agentes Wappy: plantillas de instrucciones para los agentes de IA
COPY Agentes ./Agentes

WORKDIR /app/api
EXPOSE 3080
ENV HOST=0.0.0.0
CMD ["node", "server/index.js"]