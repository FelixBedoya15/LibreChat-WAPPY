{
  "wappy-guardrails": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/pre-tool-guard.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ./hooks/post-tool-tracker.js",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ./hooks/stop-syntax-gate.js",
        "timeout": 15
      }
    ]
  }
}
